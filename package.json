{
  "name": "acservice-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo admin dashboard project.id Services (AC + Elektronik) — PERN stack",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "install:all": "npm install",
    "prisma:migrate": "npm run prisma:migrate -w backend",
    "prisma:seed": "npm run prisma:seed -w backend",
    "prisma:studio": "npm run prisma:studio -w backend",
    "build:frontend": "npm run build -w frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
